LEAD_WEBHOOK_SECRET=
# WhatsApp comercial con lada de país, p. ej. 525512345678 (10 dígitos de México también sirven: se antepone 52).
# Es público: lo muestran los botones de WhatsApp del sitio, también en Vercel, donde no hay base de datos.
WHATSAPP_NUMBER=
# Verificación de propiedad en Google Search Console y Bing Webmaster Tools (método «etiqueta HTML»). Se pega el
# token o la etiqueta <meta> completa que da cada consola; son públicos, salen en el <head>. Vacío = sin meta.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
